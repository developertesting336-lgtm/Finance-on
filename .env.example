# Database Connections (Supabase / Postgres)
DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."

# Security / JWT
JWT_SECRET="your_jwt_secret_key"

# Google OAuth (Client ID from Google Cloud Console)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Frontend Web Application URL
FRONTEND_URL="https://finance-on-leyva.base44.app"

# Production SMTP Email Configuration (e.g. Gmail / Brevo / Resend / SendGrid)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-digit-app-password"
SMTP_FROM="Finance-on <noreply@financeon.com>"

# Server Port (Defaults to 3000 or platform PORT)
PORT=3000
